{
  "name": "echo",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  }
}
